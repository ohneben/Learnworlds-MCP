# =====================================================================
# LearnWorlds MCP — copy this file to `.env` and fill in the three
# required values below. `.env` is git-ignored — never commit real secrets.
# =====================================================================

# ─── Required: LearnWorlds API credentials ───────────────────────────
# 1) Base URL of YOUR LearnWorlds school's API.
#    Default form: https://<your-school>.learnworlds.com/admin/api
#    If your school uses a custom domain, use that host instead, e.g.
#    https://academy.example.com/admin/api
LEARNWORLDS_BASE_URL=https://your-school.learnworlds.com/admin/api

# 2) Bearer access token.
#    LearnWorlds admin → Settings → Integrations → Developers (API).
#    Paste the token VALUE only (no "Bearer " prefix — the server adds it).
LEARNWORLDS_API_TOKEN=your-access-token

# 3) Your school's Client ID (same screen as the token).
#    Sent as the `Lw-Client` header on every request.
LEARNWORLDS_CLIENT_ID=your-client-id

# ─── Optional: transport ─────────────────────────────────────────────
# "stdio" (Claude Desktop / local launchers) or "http" (hosted / Docker).
# The Docker image defaults to http.
MCP_TRANSPORT=http

# HTTP transport settings (ignored for stdio).
PORT=8765
HOST=0.0.0.0
MCP_HTTP_PATH=/mcp

# Protect the exposed HTTP endpoint with a bearer token. Strongly recommended
# if the container is reachable from anything but localhost. Leave empty to
# disable (fine for the default 127.0.0.1-only bind).
MCP_SHARED_TOKEN=

# ─── Optional: resilience & throttling ───────────────────────────────
# LearnWorlds allows 30 requests / 10 s; the server self-throttles below that.
# Set LEARNWORLDS_MAX_REQUESTS=0 to disable client-side throttling entirely.
LEARNWORLDS_MAX_REQUESTS=25
LEARNWORLDS_RATE_WINDOW_MS=10000

# Automatic retries on 429 / 5xx / network errors (honors Retry-After).
LEARNWORLDS_MAX_RETRIES=3

# Per-attempt request timeout in milliseconds.
LEARNWORLDS_TIMEOUT_MS=30000

# ─── Optional: override the bundled OpenAPI spec ─────────────────────
# Only set this if you have a newer LearnWorlds YAML you want to load instead.
# LEARNWORLDS_OPENAPI_PATH=/abs/path/to/learnworlds-openapi.yaml
